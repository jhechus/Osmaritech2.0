# Usadas por api/log-question.js para guardar en Supabase
# las preguntas que el chatbot no supo responder.
#
# Configura estas mismas variables en Vercel:
# Project Settings -> Environment Variables
#
# NUNCA pongas la service_role key en código del navegador (src/) —
# solo debe existir aquí y en funciones serverless (api/).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
